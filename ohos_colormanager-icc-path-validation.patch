+/* check for C0/C1 control characters, used to keep PPD-supplied strings
+   safe to write to stderr (CUPS forwards filter stderr to the job log) */
+static int
+_has_control_chars (const char *s)                 /* String to check */
+{
+  const char *c;
+
+  for (c = s; *c != '\0'; c++)
+    if (iscntrl((unsigned char)*c))
+      return 1;
+  return 0;
+}
+
+/* check for ".." as a complete path segment (not as a substring of
+   legitimate file names such as "Driver..2.icc"); a lone "." segment is
+   harmless and gets folded away by realpath() during validation */
+static int
+_path_has_dotdot_segment (const char *path)         /* Path to check */
+{
+  const char *p = path;
+  int         at_segment_start = 1;   /* start of string behaves as if preceded by '/' */
+
+  /* forward-only scan: a ".." is a segment only when bounded by string start
+     or '/' on the left and string end or '/' on the right */
+  while (*p != '\0') {
+    if (at_segment_start && p[0] == '.' && p[1] == '.' &&
+        (p[2] == '\0' || p[2] == '/'))
+      return 1;
+    at_segment_start = (*p == '/');
+    p++;
+  }
+  return 0;
+}
+
+/*
+ * Validate an attacker-controlled ICC profile path candidate: resolve it
+ * to a canonical absolute path (following symlinks, "." and ".." segments),
+ * require it to be a regular file (same type rule as CUPS' _cupsFileCheck),
+ * and accept it only if it lies inside one of the known profile directories.
+ * On success the canonical path is written to "resolved" and 1 is returned.
+ */
+static int
+_icc_profile_path_is_allowed (const char *candidate,       /* Path to check */
+                              char       *resolved,        /* Canonical path out */
+                              size_t      resolvedsize)    /* Size of resolved */
+{
+  const char *prefixes[2];
+  char        realdir[PATH_MAX];
+  size_t      dir_len;
+  int         numprefixes = 0;
+  int         i;
+  struct stat fileinfo;                   /* File type information */
+
+  if (candidate == NULL || candidate[0] == '\0' ||
+      resolved == NULL || resolvedsize < PATH_MAX ||
+      strlen(candidate) >= PATH_MAX)
+    return 0;
+
+  /* realpath() also implies the existence check, replacing access() */
+  if (realpath(candidate, resolved) == NULL)
+    return 0;
+
+  /* regular files only: never hand out a directory or device node (aligns
+     with CUPS' _cupsFileCheck() file-type rule) */
+  if (stat(resolved, &fileinfo) != 0 || !S_ISREG(fileinfo.st_mode))
+    return 0;
+
+  prefixes[numprefixes++] = CUPSDATA "/profiles";
+#ifdef CUPS_DATADIR
+  /* config.h may set CUPS_DATADIR == CUPSDATA; avoid checking twice */
+  if (strcmp(prefixes[0], CUPS_DATADIR "/profiles") != 0)
+    prefixes[numprefixes++] = CUPS_DATADIR "/profiles";
+#endif
+
+  for (i = 0; i < numprefixes; i++) {
+    /* Skip whitelist dirs that do not exist on this system */
+    if (realpath(prefixes[i], realdir) == NULL)
+      continue;
+    dir_len = strlen(realdir);
+    /* Require a path-component boundary after the prefix so that
+       "/foo/profiles2" cannot match "/foo/profiles" */
+    if (strncmp(resolved, realdir, dir_len) == 0 &&
+        resolved[dir_len] == '/')
+      return 1;
+  }
+
+  return 0;
+}
